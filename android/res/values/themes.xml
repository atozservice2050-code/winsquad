<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: windowBackground shows the native splash instantly, no activity delay. -->
    <style name="Theme.WinSquad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/dark_green</item>
        <item name="android:navigationBarColor">@color/dark_green_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
